{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "wilds-control (Uvicorn :8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["--factory", "wilds.control.app:create_app", "--host", "localhost", "--port", "8001", "--reload"],
      "python": "${workspaceFolder}/../.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "env": {
        "WILDS_ROOT": "${userHome}/wilds-dev",
        "WILDS_LOIS_DATA_ROOT": "${userHome}/wilds-dev/share",
        "WILDS_CONTROL_CONFIG": "${workspaceFolder}/dev/config.toml",
        "WILDS_CONTROL_PASSPHRASES": "${workspaceFolder}/../.vault/passphrases.toml"
      },
      "justMyCode": true
    }
  ]
}
